# Copy to .env and export before running, or set these in your shell.
# Nothing here is required — the platform runs fully offline by default.

# --- server -----------------------------------------------------------------
DUB_HOST=127.0.0.1
DUB_PORT=8000
DUB_WORKERS=2                 # concurrent pipeline jobs
DUB_SAMPLE_RATE=24000
DUB_DATA_DIR=./data
DUB_MAX_UPLOAD_MB=512

# --- provider selection ("auto" = best locally installed, else offline) ------
DUB_ASR=auto                  # faster_whisper | whisper | openai_api | offline
DUB_MT=auto                   # llm | argos | passthrough
DUB_TTS=auto                  # xtts | f5 | chatterbox | piper | elevenlabs |
                              # playht | cartesia | local_formant
DUB_SEPARATION=auto           # demucs | spectral
DUB_LIPSYNC=auto              # wav2lip | none

# --- optional model config --------------------------------------------------
DUB_WHISPER_MODEL=base        # tiny | base | small | medium | large-v3
DUB_PIPER_VOICE_DIR=          # directory containing .onnx Piper voices
DUB_RVC_MODEL=                # path to a trained RVC .pth
DUB_WAV2LIP_DIR=              # checkout of the Wav2Lip repo
DUB_WAV2LIP_CKPT=

# --- optional commercial APIs -----------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ELEVENLABS_API_KEY=
PLAYHT_API_KEY=
PLAYHT_USER_ID=
CARTESIA_API_KEY=
